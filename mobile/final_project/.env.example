# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
# 아무 키도 없으면 데모 데이터로 실행됩니다.

# Supabase (https://supabase.com) — 회원가입·로그인·게시판·투자 기록
# 프로젝트 설정 → API에서 Project URL과 anon public 키를 복사한다.
# service_role 키는 여기에 넣지 않는다(브라우저로 나가면 모든 권한이 열린다).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com) — 국내·미국 시세
KIS_APP_KEY=
KIS_APP_SECRET=
# real(실전) 또는 paper(모의투자)
KIS_ENV=real

# 네이버 개발자센터 검색 API (https://developers.naver.com) — 국내 종목 뉴스
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Finnhub (https://finnhub.io) — 미국 종목 뉴스
FINNHUB_API_KEY=

# 배포 시 접근 비밀번호 (설정하면 HTTP 기본 인증이 걸립니다)
SITE_PASSWORD=
