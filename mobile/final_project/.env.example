# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
# 아무 키도 없으면 데모 데이터로 실행됩니다.

# Supabase (https://supabase.com) — 회원가입·로그인·게시판·투자 기록
# 프로젝트 설정 → API에서 Project URL과 anon public 키를 복사한다.
# service_role 키는 여기에 넣지 않는다(브라우저로 나가면 모든 권한이 열린다).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com) — 국내·미국 시세
KIS_APP_KEY=
KIS_APP_SECRET=
# real(실전) 또는 paper(모의투자)
KIS_ENV=real

# 네이버 뉴스 검색 — 뉴스 화면·홈의 시장 뉴스, 국내 종목 뉴스
# (1) 기존 개발자센터 키 (https://developers.naver.com). 2026년 7월 말 신규 발급이 끝났고 2027년 6월 말까지 사용 가능
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (2) 새로 받는 NAVER API HUB 키 (네이버 클라우드 플랫폼, 종량제 과금). 둘 다 있으면 HUB를 쓴다.
#     뉴스 검색 주소(/search/v1/news)는 네이버 클라우드 이관 가이드로 확인함. 검색 결과는 약관상 서버에 캐시하지 않는다.
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=

# 경제 지표 (둘 다 무료). 없으면 경제지표 화면에 '키가 필요해요' 안내가 나온다
# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html) — 미국 금리·물가·고용·환율·유가
FRED_API_KEY=
# 한국은행 ECOS Open API (https://ecos.bok.or.kr/api/) — 한국 기준금리
ECOS_API_KEY=

# Finnhub (https://finnhub.io) — 미국 종목 뉴스
FINNHUB_API_KEY=

# 배포 시 접근 비밀번호 (설정하면 HTTP 기본 인증이 걸립니다)
SITE_PASSWORD=
